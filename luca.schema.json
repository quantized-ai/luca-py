{
  "$defs": {
    "ClientSettings": {
      "additionalProperties": false,
      "properties": {
        "file_read": {
          "$ref": "#/$defs/FileReadSettings"
        }
      },
      "title": "ClientSettings",
      "type": "object"
    },
    "CompactionSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "keep_turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep Turns"
        },
        "default_window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Window"
        }
      },
      "title": "CompactionSettings",
      "type": "object"
    },
    "FileReadSettings": {
      "additionalProperties": false,
      "description": "The `@`-mention inline ceiling. The effective cap is the SMALLER of the\nhard limit and the model's context share, so a small-context model is never\nhanded a 25k-token file just because the hard limit permits it.",
      "properties": {
        "max_read_file_tokens_hard_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Read File Tokens Hard Limit"
        },
        "max_read_file_tokens_context_percentage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Read File Tokens Context Percentage"
        }
      },
      "title": "FileReadSettings",
      "type": "object"
    },
    "LoggingSettings": {
      "additionalProperties": false,
      "description": "Where the session log goes and how loud it is. `file` overrides the\ndefault `<session dir>/logs/<session-id>.log`; a level of `\"OFF\"` writes\nnothing at all.",
      "properties": {
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        }
      },
      "title": "LoggingSettings",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reasoning": {
          "anyOf": [
            {
              "enum": [
                "provider-default",
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelDef": {
      "additionalProperties": false,
      "description": "One model's settings, mirroring `LLMConfig`'s two dicts exactly: what\nthe model is asked (`options`) and what the provider is told\n(`provider_options`). No key is inspected on the way out of either \u2014 which\nblock a key is written in IS the routing.",
      "properties": {
        "options": {
          "$ref": "#/$defs/ModelOptionsBlock"
        },
        "provider_options": {
          "additionalProperties": true,
          "title": "Provider Options",
          "type": "object"
        }
      },
      "title": "ModelDef",
      "type": "object"
    },
    "ModelOptionsBlock": {
      "additionalProperties": true,
      "description": "One `options` block: the `luca.client.acompletion` keyword arguments a\ncall is made with, on top of WHICH model it is.\n\nThe ONE model in this file that is not `extra=\"forbid\"`, deliberately.\nThe four knobs almost everyone sets are typed and validated here, because\n`max_tokens: 0` and `reasoning: \"huge\"` are worth catching by name at boot\nrather than as a provider 400 mid-turn. Every other key falls through\nverbatim: the client takes a dozen more (`seed`, `stop`, `top_k`,\n`presence_penalty`, \u2026) and enumerating them would only mean this file\nrefusing a legitimate argument every time the client gains one.\n\nA key here that is NOT an `acompletion` argument is a `TypeError` on the\nfirst turn. Raw fields the PROVIDER documents belong in the sibling\n`provider_options` block, which is the one with no schema at all.",
      "properties": {
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "reasoning": {
          "anyOf": [
            {
              "enum": [
                "provider-default",
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        }
      },
      "title": "ModelOptionsBlock",
      "type": "object"
    },
    "PermissionMatchMode": {
      "enum": [
        "relaxed",
        "strict"
      ],
      "title": "PermissionMatchMode",
      "type": "string"
    },
    "PermissionMode": {
      "enum": [
        "ask",
        "yolo",
        "auto"
      ],
      "title": "PermissionMode",
      "type": "string"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "description": "A config allow/deny rule \u2192 a `ToolKindRule` (when `tool_kind` is set) or\na `ToolRule` over a `(permission, resource)` glob.",
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
        },
        "tool_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "permission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "decision"
      ],
      "title": "PermissionRule",
      "type": "object"
    },
    "PermissionSettings": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "match_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionMatchMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "title": "PermissionSettings",
      "type": "object"
    },
    "ProviderDef": {
      "additionalProperties": false,
      "description": "A provider entry: where the host is (`base_url` / `transport`), the\ndefaults every model on it is invoked with (`options` /\n`provider_options`), and per-model overrides (`models`). Any subset \u2014 an\nentry that only sets `options` on `openrouter` is the ordinary case.\n\n`base_url` and `transport` are passed PER CALL, never registered globally,\nso pointing a built-in provider at a proxy is as ordinary as configuring a\nhost luca has never heard of. A name `luca.client` does not know needs\nboth: they are what let it build a generic provider for it.\n\n`transport` is a dotted path to the transport CLASS\n(`\"luca.client.transports.OpenAITransport\"`), resolved by the runner at\ncall time \u2014 an import path survives the round trip through the session\nfile that a class object could not.\n\nNo api key here. Credentials live in `auth.json`; see `auth.py`.",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "transport": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport"
        },
        "options": {
          "$ref": "#/$defs/ModelOptionsBlock"
        },
        "provider_options": {
          "additionalProperties": true,
          "title": "Provider Options",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelDef"
          },
          "title": "Models",
          "type": "object"
        }
      },
      "title": "ProviderDef",
      "type": "object"
    },
    "RuntimeSettings": {
      "additionalProperties": false,
      "description": "Every `RuntimeConfig` knob, all optional (unset = leave the session's).",
      "properties": {
        "builtin_client_completion_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Builtin Client Completion Timeout In Ms"
        },
        "client_completion_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Completion Timeout In Ms"
        },
        "tool_execution_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution Timeout In Ms"
        },
        "llm_completion_cancellation_grace_period": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Completion Cancellation Grace Period"
        },
        "tool_cancellation_grace_period": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Cancellation Grace Period"
        },
        "soft_max_steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soft Max Steps"
        },
        "hard_max_steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Max Steps"
        },
        "doom_loop_threshold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doom Loop Threshold"
        },
        "limit_tool_choice_on_soft_max_steps_reached": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Tool Choice On Soft Max Steps Reached"
        },
        "limit_tool_choice_on_doom_loop_flagged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Tool Choice On Doom Loop Flagged"
        }
      },
      "title": "RuntimeSettings",
      "type": "object"
    },
    "SessionSettings": {
      "additionalProperties": false,
      "description": "Where sessions are stored. `directory` is the ROOT; the per-project\nsubdirectory is always appended under it.",
      "properties": {
        "directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory"
        }
      },
      "title": "SessionSettings",
      "type": "object"
    },
    "ThemeSettings": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "ThemeSettings",
      "type": "object"
    },
    "ToolKind": {
      "enum": [
        "read",
        "search",
        "web_fetch",
        "edit",
        "move",
        "delete",
        "execute",
        "switch_mode",
        "other"
      ],
      "title": "ToolKind",
      "type": "string"
    },
    "McpServerSettings": {
      "type": "object",
      "additionalProperties": false,
      "title": "McpServerSettings",
      "description": "One MCP server. Give either 'command' (a local server over stdio) or 'url' (a remote server over Streamable HTTP), never both. Values in 'env' and 'headers' may reference an exported environment variable as ${VAR}.",
      "properties": {
        "command": {
          "type": "string",
          "description": "The executable to run, for a stdio server."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment for the subprocess. Values may contain ${VAR}."
        },
        "url": {
          "type": "string",
          "description": "The MCP endpoint, for an http server."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Static headers sent with every request. Values may contain ${VAR}."
        },
        "oauth": {
          "type": "boolean",
          "default": false,
          "description": "Authorize in a browser on first use."
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A pre-registered OAuth client id. Omit to register dynamically."
        },
        "redirect_port": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin the OAuth loopback port. Omit to let the OS pick one, which is the default."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "connect_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "list_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "call_timeout_in_ms": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deadline for one tool call on this server. Omit to inherit runtime.tool_execution_timeout_in_ms."
        }
      }
    },
    "McpSettings": {
      "type": "object",
      "additionalProperties": false,
      "title": "McpSettings",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connect to the configured MCP servers. Defaults to true; --no-mcp overrides it."
        },
        "servers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/McpServerSettings"
          },
          "description": "Servers by label. The label prefixes every tool name the model sees."
        }
      }
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "theme": {
      "$ref": "#/$defs/ThemeSettings"
    },
    "sessions": {
      "$ref": "#/$defs/SessionSettings"
    },
    "logging": {
      "$ref": "#/$defs/LoggingSettings"
    },
    "client": {
      "$ref": "#/$defs/ClientSettings"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeSettings"
    },
    "compaction": {
      "$ref": "#/$defs/CompactionSettings"
    },
    "permissions": {
      "$ref": "#/$defs/PermissionSettings"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderDef"
      },
      "title": "Providers",
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Models",
      "type": "object"
    },
    "workspace": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace"
    },
    "additional_directories": {
      "items": {
        "type": "string"
      },
      "title": "Additional Directories",
      "type": "array"
    },
    "extra_skill_locations": {
      "items": {
        "type": "string"
      },
      "title": "Extra Skill Locations",
      "type": "array"
    },
    "extra_command_locations": {
      "items": {
        "type": "string"
      },
      "title": "Extra Command Locations",
      "type": "array"
    },
    "instructions": {
      "items": {
        "type": "string"
      },
      "title": "Instructions",
      "type": "array"
    },
    "streaming": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Streaming"
    },
    "mcp": {
      "$ref": "#/$defs/McpSettings",
      "default": {},
      "description": "External MCP servers whose tools the model may call."
    },
    "checkpoints": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Snapshot the workspace before each turn so /undo and /rewind can restore it. Needs a git binary. Defaults to true.",
      "title": "Checkpoints"
    },
    "use_native_tools": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Offer the provider's own native tools where the active model supports them (apply_patch + shell on OpenAI, text_editor + bash on Anthropic). Defaults to true.",
      "title": "Use Native Tools"
    }
  },
  "title": "LucaConfig",
  "type": "object",
  "$id": "https://github.com/quantized-ai/luca-py/luca.schema.json",
  "description": "Project + user configuration for the Luca TUI."
}

# Harbor, uv and a Docker client, for running Terminal-Bench without installing
# any of it on the host. See docker/docker-compose.bench.yml.
#
# Deliberately does NOT contain the repo: that is bind-mounted at its host path
# so Harbor's sibling containers resolve mounts the same way we do.

FROM python:3.12-slim

# docker.io is the CLI only; it talks to the mounted socket.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /usr/local/bin/

# The venv lives in the image, not the bind-mounted repo, so `uv sync` does not
# write a Linux venv over the contributor's own.
ENV UV_PROJECT_ENVIRONMENT=/opt/bench-venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

# Warm the cache; the entrypoint syncs the mounted project for real.
RUN uv venv "$UV_PROJECT_ENVIRONMENT" \
    && uv pip install --python "$UV_PROJECT_ENVIRONMENT" "harbor>=0.20" pytest pytest-asyncio

COPY docker/bench-entrypoint.sh /usr/local/bin/bench-entrypoint
RUN chmod +x /usr/local/bin/bench-entrypoint

ENTRYPOINT ["bench-entrypoint"]
CMD ["harbor", "run", "-d", "terminal-bench/terminal-bench-2-1", "-a", "oracle", "-l", "5"]
